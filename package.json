{
    "name":  "batchlivetrainer",
    "productName":  "BatchLiveTrainer",
    "version":  "1.0.0",
    "description":  "BatchLiveTrainer - the BatchLive DeltaV simulator set up for working Emerson DeltaV course workshops (Course 7016, DeltaV Batch) step by step.",
    "author":  "BatchLiveTrainer",
    "license":  "MIT",
    "main":  "./out/main/index.js",
    "scripts":  {
                    "dev":  "electron-vite dev",
                    "build":  "electron-vite build",
                    "preview":  "electron-vite preview",
                    "start":  "electron-vite preview",
                    "typecheck":  "tsc --noEmit -p tsconfig.node.json \u0026\u0026 tsc --noEmit -p tsconfig.web.json",
                    "test:control":  "node --test tests/control-strategy.test.cjs",
                    "test:sfc":  "node --test tests/sfc-qualifiers.test.cjs tests/sfc-properties.test.cjs tests/sfc-lifecycle.test.cjs tests/sfc-message.test.cjs tests/sfc-routing.test.cjs tests/sfc-course-paths.test.cjs tests/sfc-parallel.test.cjs tests/sfc-boolean.test.cjs tests/sfc-block-alarm.test.cjs tests/sfc-level-reset.test.cjs",
                    "test:named-sets":  "node --test tests/named-sets.test.cjs",
                    "test:course6":  "node --test tests/course7016-ch6.test.cjs",
                    "dist":  "electron-vite build \u0026\u0026 electron-builder",
                    "dist:win":  "electron-vite build \u0026\u0026 electron-builder --win",
                    "icon":  "node scripts/gen-icon.mjs",
                    "postinstall":  "electron-builder install-app-deps",
                    "test":  "node --test tests/*.test.cjs"
                },
    "dependencies":  {
                         "zustand":  "^5.0.2"
                     },
    "devDependencies":  {
                            "@vitejs/plugin-react":  "^4.3.4",
                            "@types/node":  "^22.10.2",
                            "@types/react":  "^18.3.17",
                            "@types/react-dom":  "^18.3.5",
                            "electron":  "^33.2.1",
                            "electron-builder":  "^25.1.8",
                            "electron-vite":  "^2.3.0",
                            "react":  "^18.3.1",
                            "react-dom":  "^18.3.1",
                            "typescript":  "^5.7.2",
                            "vite":  "^5.4.11"
                        }
}
